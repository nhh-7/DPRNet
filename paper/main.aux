\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Routing cluster maps at $\times 4$. Each pixel of the LR input is colored by its assigned prototype index $b_n=\arg \max _m S_{n,m}$ (Eq.~\eqref  {eq:belong}), reshaped from the original token order to $H\times W$, for three TAB blocks ($b_0,b_3,b_7$); the leftmost panel is the nearest-neighbor-magnified LR image for reference. The maps follow image content rather than a fixed spatial grid: repetitive building facades in Urban100 and high-contrast strokes in Manga109 are grouped into coherent prototypes, and the partition becomes finer in the deeper, larger-$M$ blocks. Colors encode prototype identity within a block and are not comparable across blocks. This visualizes the same routing signal whose confidence $x^{\mathrm  {s}}$ is quantified in Fig.~\ref {fig:xscore_hist}.}}{13}{figure.caption.44}\protected@file@percent }
\newlabel{fig:cluster_maps}{{7}{13}{Routing cluster maps at $\times 4$. Each pixel of the LR input is colored by its assigned prototype index $b_n=\arg \max _m S_{n,m}$ (Eq.~\eqref {eq:belong}), reshaped from the original token order to $H\times W$, for three TAB blocks ($b_0,b_3,b_7$); the leftmost panel is the nearest-neighbor-magnified LR image for reference. The maps follow image content rather than a fixed spatial grid: repetitive building facades in Urban100 and high-contrast strokes in Manga109 are grouped into coherent prototypes, and the partition becomes finer in the deeper, larger-$M$ blocks. Colors encode prototype identity within a block and are not comparable across blocks. This visualizes the same routing signal whose confidence $x^{\mathrm {s}}$ is quantified in Fig.~\ref {fig:xscore_hist}}{figure.caption.44}{}}
\newlabel{fig:cluster_maps@cref}{{[figure][7][]7}{[1][12][]13}{}{}{}}
