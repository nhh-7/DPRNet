\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Distribution of the per-token routing confidence $x^{\mathrm  {s}}=\max _m S_{n,m}$ (Eq.~\eqref  {eq:belong}) at $\times 4$, accumulated over \emph  {all} test images of (a)~Urban100 and (b)~Manga109 with the final model. Curves are shown for three representative TAB blocks with increasing prototype count $M$; dotted vertical lines mark the uniform-assignment floor $1/M$. In every plotted block the distribution sits clearly to the right of its floor (block means are about $1.5$--$2.1$ times $1/M$) yet stays far from $1$, confirming that the softmax assignment is \emph  {informative but soft}: tokens commit to a prototype more than chance while retaining the graded confidence that the C3 components (ordering key, IASA gate, soft fallback) rely on. As $M$ grows the mode shifts toward the (lower) floor, consistent with confidence being spread over more slots.}}{12}{figure.caption.44}\protected@file@percent }
\newlabel{fig:xscore_hist}{{5}{12}{Distribution of the per-token routing confidence $x^{\mathrm {s}}=\max _m S_{n,m}$ (Eq.~\eqref {eq:belong}) at $\times 4$, accumulated over \emph {all} test images of (a)~Urban100 and (b)~Manga109 with the final model. Curves are shown for three representative TAB blocks with increasing prototype count $M$; dotted vertical lines mark the uniform-assignment floor $1/M$. In every plotted block the distribution sits clearly to the right of its floor (block means are about $1.5$--$2.1$ times $1/M$) yet stays far from $1$, confirming that the softmax assignment is \emph {informative but soft}: tokens commit to a prototype more than chance while retaining the graded confidence that the C3 components (ordering key, IASA gate, soft fallback) rely on. As $M$ grows the mode shifts toward the (lower) floor, consistent with confidence being spread over more slots}{figure.caption.44}{}}
\newlabel{fig:xscore_hist@cref}{{[figure][5][]5}{[1][12][]12}{}{}{}}
\def\@LN@column{2}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Normalized prototype-usage entropy $\mathcal  {H}(u)$ (Eq.~\eqref  {eq:balance}; higher $=$ more balanced) per TAB block ($b_0$--$b_7$) at $\times 4$ on Urban100 (full model, representative seed $3407$). The usage-balancing regularizer increases the entropy in \emph  {all eight} blocks (block-mean $0.623\!\rightarrow \!0.686$), confirming that it counteracts the collapse onto a few prototypes encouraged by the learnable temperature (C4).}}{12}{figure.caption.45}\protected@file@percent }
\newlabel{fig:usage_entropy}{{6}{12}{Normalized prototype-usage entropy $\mathcal {H}(u)$ (Eq.~\eqref {eq:balance}; higher $=$ more balanced) per TAB block ($b_0$--$b_7$) at $\times 4$ on Urban100 (full model, representative seed $3407$). The usage-balancing regularizer increases the entropy in \emph {all eight} blocks (block-mean $0.623\!\rightarrow \!0.686$), confirming that it counteracts the collapse onto a few prototypes encouraged by the learnable temperature (C4)}{figure.caption.45}{}}
\newlabel{fig:usage_entropy@cref}{{[figure][6][]6}{[1][12][]12}{}{}{}}
\citation{glasner2009single}
\citation{mei2020csnln}
\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Routing cluster maps at $\times 4$. Each LR pixel is colored by its assigned prototype index $b_n=\arg \max _m S_{n,m}$ (Eq.~\eqref  {eq:belong}) and reshaped from the original token order to $H\times W$. Read each row by comparing the cluster boundaries with the reference LR image: the early block forms coarse content groups, while the deeper blocks split repeated facade elements and high-contrast strokes into finer partitions. Colors encode prototype identity within a block and are not comparable across blocks, so the meaningful cue is region continuity rather than a specific hue. This visualizes the same routing signal whose confidence $x^{\mathrm  {s}}$ is quantified in Figure~\ref {fig:xscore_hist}.}}{13}{figure.caption.46}\protected@file@percent }
\newlabel{fig:cluster_maps}{{7}{13}{Routing cluster maps at $\times 4$. Each LR pixel is colored by its assigned prototype index $b_n=\arg \max _m S_{n,m}$ (Eq.~\eqref {eq:belong}) and reshaped from the original token order to $H\times W$. Read each row by comparing the cluster boundaries with the reference LR image: the early block forms coarse content groups, while the deeper blocks split repeated facade elements and high-contrast strokes into finer partitions. Colors encode prototype identity within a block and are not comparable across blocks, so the meaningful cue is region continuity rather than a specific hue. This visualizes the same routing signal whose confidence $x^{\mathrm {s}}$ is quantified in Figure~\ref {fig:xscore_hist}}{figure.caption.46}{}}
\newlabel{fig:cluster_maps@cref}{{[figure][7][]7}{[1][12][]13}{}{}{}}
