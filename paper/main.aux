\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Overall architecture of DPRNet. A $3{\times }3$ convolution extracts shallow features $F_0$ ($C{=}40$); a stack of $L{=}8$ blocks, each coupling a Token Aggregation Block (TAB) with local self-attention (LRSA) and a fusion convolution under a residual connection (Eq.~\eqref  {eq:assign} context, Eqs.~(1)--(3)), produces $F_L$; a global residual, a pixel-shuffle upsampler and a bilinear bypass reconstruct $I_{SR}$. The contribution is confined to the DPR module inside each TAB (highlighted), whose data flow $X\to \mathrm  {LN}\to \mathrm  {DPR}\to \mathrm  {IASA} \to \mathrm  {Conv}_{1\times 1}\to \mathrm  {ConvFFN}$ keeps the TAB interface $\mathbb  {R}^{C\times H\times W}\!\to \!\mathbb  {R}^{C\times H\times W}$ unchanged, so the rest of the CATANet backbone is a drop-in host; DPR is detailed in Fig.~\ref {fig:dpr}.}}{5}{figure.caption.12}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:arch}{{1}{5}{Overall architecture of DPRNet. A $3{\times }3$ convolution extracts shallow features $F_0$ ($C{=}40$); a stack of $L{=}8$ blocks, each coupling a Token Aggregation Block (TAB) with local self-attention (LRSA) and a fusion convolution under a residual connection (Eq.~\eqref {eq:assign} context, Eqs.~(1)--(3)), produces $F_L$; a global residual, a pixel-shuffle upsampler and a bilinear bypass reconstruct $I_{SR}$. The contribution is confined to the DPR module inside each TAB (highlighted), whose data flow $X\to \mathrm {LN}\to \mathrm {DPR}\to \mathrm {IASA} \to \mathrm {Conv}_{1\times 1}\to \mathrm {ConvFFN}$ keeps the TAB interface $\mathbb {R}^{C\times H\times W}\!\to \!\mathbb {R}^{C\times H\times W}$ unchanged, so the rest of the CATANet backbone is a drop-in host; DPR is detailed in Fig.~\ref {fig:dpr}}{figure.caption.12}{}}
\newlabel{fig:arch@cref}{{[figure][1][]1}{[1][4][]5}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Dynamic Prototype Routing (DPR). \textbf  {(1)} Tokens generate dynamic prototypes $P^{\mathrm  {c}}$ from the current input by soft assignment (Eqs.~\eqref  {eq:assign}--\eqref  {eq:proto_content}, C1); \textbf  {(2)} a learnable query bank refines them through a gate $\gamma $ into the confirmed prototypes $P$ (Eq.~\eqref  {eq:proto_refine}, C2); \textbf  {(3)} tokens are matched back with a learnable temperature $\tau $, yielding scores $S$, confidence $x^{\mathrm  {s}}$ and labels $b$ (Eqs.~\eqref  {eq:scores}--\eqref  {eq:belong}, C3/C4); \textbf  {(4)} a confidence-aware key orders tokens (Eq.~\eqref  {eq:sortkey}, C3); \textbf  {(5)} IASA aggregates the reordered tokens with a confidence-modulated global gate $\beta $ and a soft prototype fallback $\alpha $ (Eqs.~\eqref  {eq:iasa_gate}--\eqref  {eq:soft_fallback}, C3); and \textbf  {(6)} a usage-entropy regularizer balances prototype usage (Eq.~\eqref  {eq:balance}, C4). Solid arrows denote tensor flow, dashed arrows denote gating/regularization. The yellow tags mark the ablation switches A1/A2/A3 (Tables~\ref {tab:abl_a1}--\ref {tab:abl_a3}); each switch defaults to the full model and is exactly equivalent to its disabled form.}}{5}{figure.caption.13}\protected@file@percent }
\newlabel{fig:dpr}{{2}{5}{Dynamic Prototype Routing (DPR). \textbf {(1)} Tokens generate dynamic prototypes $P^{\mathrm {c}}$ from the current input by soft assignment (Eqs.~\eqref {eq:assign}--\eqref {eq:proto_content}, C1); \textbf {(2)} a learnable query bank refines them through a gate $\gamma $ into the confirmed prototypes $P$ (Eq.~\eqref {eq:proto_refine}, C2); \textbf {(3)} tokens are matched back with a learnable temperature $\tau $, yielding scores $S$, confidence $x^{\mathrm {s}}$ and labels $b$ (Eqs.~\eqref {eq:scores}--\eqref {eq:belong}, C3/C4); \textbf {(4)} a confidence-aware key orders tokens (Eq.~\eqref {eq:sortkey}, C3); \textbf {(5)} IASA aggregates the reordered tokens with a confidence-modulated global gate $\beta $ and a soft prototype fallback $\alpha $ (Eqs.~\eqref {eq:iasa_gate}--\eqref {eq:soft_fallback}, C3); and \textbf {(6)} a usage-entropy regularizer balances prototype usage (Eq.~\eqref {eq:balance}, C4). Solid arrows denote tensor flow, dashed arrows denote gating/regularization. The yellow tags mark the ablation switches A1/A2/A3 (Tables~\ref {tab:abl_a1}--\ref {tab:abl_a3}); each switch defaults to the full model and is exactly equivalent to its disabled form}{figure.caption.13}{}}
\newlabel{fig:dpr@cref}{{[figure][2][]2}{[1][4][]5}{}{}{}}
