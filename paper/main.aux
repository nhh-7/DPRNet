\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Overall architecture of DPRNet, following the lightweight-SR backbone of CATANet. \textbf  {(a)}~A $3{\times }3$ convolution extracts shallow features $F_0$, which pass through a stack of $L{=}8$ DPRNet blocks; the deep features are added back through a global residual and reconstructed by a pixel-shuffle upsampler that is summed with a bilinearly upsampled base image. \textbf  {(b)}~Each block keeps the TAB--LRSA--fusion structure under a residual connection. \textbf  {(c)}~Inside a TAB, the only modified component is the routing module: DPR replaces center-based routing while preserving the input/output interface, and is expanded in Figure~\ref {fig:dpr}.}}{5}{figure.caption.12}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:arch}{{1}{5}{Overall architecture of DPRNet, following the lightweight-SR backbone of CATANet. \textbf {(a)}~A $3{\times }3$ convolution extracts shallow features $F_0$, which pass through a stack of $L{=}8$ DPRNet blocks; the deep features are added back through a global residual and reconstructed by a pixel-shuffle upsampler that is summed with a bilinearly upsampled base image. \textbf {(b)}~Each block keeps the TAB--LRSA--fusion structure under a residual connection. \textbf {(c)}~Inside a TAB, the only modified component is the routing module: DPR replaces center-based routing while preserving the input/output interface, and is expanded in Figure~\ref {fig:dpr}}{figure.caption.12}{}}
\newlabel{fig:arch@cref}{{[figure][1][]1}{[1][4][]5}{}{}{}}
\def\@LN@column{2}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Dynamic Prototype Routing (DPR). \textbf  {(a)}~The router runs in a single pass: it embeds the tokens, forms content prototypes $P^{\mathrm  {c}}$ from the current tokens, confirms them with a learnable query bank through a gated refinement ($\gamma $), and matches the tokens back to the confirmed prototypes $P$ with a bounded temperature $\tau $, yielding the ordered sequence $X^{\pi }$, the confidence $x^{\mathrm  {s}}$, and the label $b$ (Eqs.~\eqref  {eq:assign}--\eqref  {eq:sortkey}); the usage-balancing term acts on the score map $S$ (Eq.~\eqref  {eq:balance}). \textbf  {(b)}~IASA consumes $X^{\pi }$, $P$, and $x^{\mathrm  {s}}$: a local branch and a prototype global branch are combined under a confidence-modulated gate $\beta $, and a soft prototype fallback gated by $\alpha $ stabilizes low-confidence tokens before the output is scattered back via $\pi ^{-1}$ (Eqs.~\eqref  {eq:iasa_gate}--\eqref  {eq:soft_fallback}).}}{5}{figure.caption.13}\protected@file@percent }
\newlabel{fig:dpr}{{2}{5}{Dynamic Prototype Routing (DPR). \textbf {(a)}~The router runs in a single pass: it embeds the tokens, forms content prototypes $P^{\mathrm {c}}$ from the current tokens, confirms them with a learnable query bank through a gated refinement ($\gamma $), and matches the tokens back to the confirmed prototypes $P$ with a bounded temperature $\tau $, yielding the ordered sequence $X^{\pi }$, the confidence $x^{\mathrm {s}}$, and the label $b$ (Eqs.~\eqref {eq:assign}--\eqref {eq:sortkey}); the usage-balancing term acts on the score map $S$ (Eq.~\eqref {eq:balance}). \textbf {(b)}~IASA consumes $X^{\pi }$, $P$, and $x^{\mathrm {s}}$: a local branch and a prototype global branch are combined under a confidence-modulated gate $\beta $, and a soft prototype fallback gated by $\alpha $ stabilizes low-confidence tokens before the output is scattered back via $\pi ^{-1}$ (Eqs.~\eqref {eq:iasa_gate}--\eqref {eq:soft_fallback})}{figure.caption.13}{}}
\newlabel{fig:dpr@cref}{{[figure][2][]2}{[1][4][]5}{}{}{}}
