\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Dynamic Prototype Routing (DPR). \textbf  {(a)}~The router runs in a single pass: it embeds the tokens, forms content prototypes $P^{\mathrm  {c}}$ from the current tokens, confirms them with a learnable query bank through a gated refinement ($\gamma $), and matches the tokens back to the confirmed prototypes $P$ with a bounded temperature $\tau $, yielding the ordered sequence $X^{\pi }$, the confidence $x^{\mathrm  {s}}$, and the label $b$ (Eqs.~\eqref  {eq:assign}--\eqref  {eq:sortkey}); the usage-balancing term acts on the score map $S$ (Eq.~\eqref  {eq:balance}). \textbf  {(b)}~IASA consumes $X^{\pi }$, $P$, and $x^{\mathrm  {s}}$: a local branch and a prototype global branch are combined under a confidence-modulated gate $\beta $, and a soft prototype fallback gated by $\alpha $ stabilizes low-confidence tokens before the output is scattered back via $\pi ^{-1}$ (Eqs.~\eqref  {eq:iasa_gate}--\eqref  {eq:soft_fallback}).}}{8}{figure.caption.2}\protected@file@percent }
\newlabel{fig:dpr}{{2}{8}{Dynamic Prototype Routing (DPR). \textbf {(a)}~The router runs in a single pass: it embeds the tokens, forms content prototypes $P^{\mathrm {c}}$ from the current tokens, confirms them with a learnable query bank through a gated refinement ($\gamma $), and matches the tokens back to the confirmed prototypes $P$ with a bounded temperature $\tau $, yielding the ordered sequence $X^{\pi }$, the confidence $x^{\mathrm {s}}$, and the label $b$ (Eqs.~\eqref {eq:assign}--\eqref {eq:sortkey}); the usage-balancing term acts on the score map $S$ (Eq.~\eqref {eq:balance}). \textbf {(b)}~IASA consumes $X^{\pi }$, $P$, and $x^{\mathrm {s}}$: a local branch and a prototype global branch are combined under a confidence-modulated gate $\beta $, and a soft prototype fallback gated by $\alpha $ stabilizes low-confidence tokens before the output is scattered back via $\pi ^{-1}$ (Eqs.~\eqref {eq:iasa_gate}--\eqref {eq:soft_fallback})}{figure.caption.2}{}}
\newlabel{fig:dpr@cref}{{[figure][2][]2}{[1][6][]8}{}{}{}}
