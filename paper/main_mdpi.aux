\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces Ablation A3 ($\times 4$): prototype balance loss. Reconstruction PSNR(dB) and block-averaged normalized prototype-usage entropy on Urban100 (higher $=$ more balanced), each reported as mean$\pm $std over three seeds. The balance loss raises usage entropy while also \emph  {reducing seed-to-seed variance} on both benchmarks and on the usage entropy itself, supporting the stabilizing role claimed for C4.}}{16}{table.caption.11}\protected@file@percent }
\newlabel{tab:abl_a3}{{7}{16}{Ablation A3 ($\times 4$): prototype balance loss. Reconstruction PSNR(dB) and block-averaged normalized prototype-usage entropy on Urban100 (higher $=$ more balanced), each reported as mean$\pm $std over three seeds. The balance loss raises usage entropy while also \emph {reducing seed-to-seed variance} on both benchmarks and on the usage entropy itself, supporting the stabilizing role claimed for C4}{table.caption.11}{}}
\newlabel{tab:abl_a3@cref}{{[table][7][]7}{[1][14][]16}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces Per-block normalized prototype-usage entropy (Urban100, representative seed $3407$). The balance loss increases usage entropy in every TAB block ($b_0$--$b_7$).}}{16}{table.caption.11}\protected@file@percent }
