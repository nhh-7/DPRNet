\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Ablation C1 ($\times 4$): dynamic per-image prototypes (DPR, $=$ full model) vs.\ a cross-batch history center with EMA update (EMA-center), both trained for $250$k on DIV2K over three seeds. Values are mean$\pm $std PSNR(dB)/SSIM (Y channel) on Set5 and Urban100. Under a matched protocol that differs \emph  {only} in the prototype generator, dynamic prototypes give the better reconstruction on both benchmarks with lower seed variance.}}{15}{table.caption.8}\protected@file@percent }
\newlabel{tab:abl_c1}{{4}{15}{Ablation C1 ($\times 4$): dynamic per-image prototypes (DPR, $=$ full model) vs.\ a cross-batch history center with EMA update (EMA-center), both trained for $250$k on DIV2K over three seeds. Values are mean$\pm $std PSNR(dB)/SSIM (Y channel) on Set5 and Urban100. Under a matched protocol that differs \emph {only} in the prototype generator, dynamic prototypes give the better reconstruction on both benchmarks with lower seed variance}{table.caption.8}{}}
\newlabel{tab:abl_c1@cref}{{[table][4][]4}{[1][14][]15}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Ablation A1 ($\times 4$): prototype query refine. PSNR(dB) mean$\pm $std (Y channel) over three seeds. Enabling refine improves reconstruction on both benchmarks by more than the seed variance, confirming that decoupling prototype generation from confirmation (C2) is quality-positive; we retain it by default.}}{15}{table.caption.9}\protected@file@percent }
\newlabel{tab:abl_a1}{{5}{15}{Ablation A1 ($\times 4$): prototype query refine. PSNR(dB) mean$\pm $std (Y channel) over three seeds. Enabling refine improves reconstruction on both benchmarks by more than the seed variance, confirming that decoupling prototype generation from confirmation (C2) is quality-positive; we retain it by default}{table.caption.9}{}}
