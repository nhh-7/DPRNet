\@writefile{toc}{\contentsline {paragraph}{\numberline {3.6.0.4}Summary.}{16}{paragraph.3.6.0.4}\protected@file@percent }
\citation{glasner2009single,huang2015urban100,mei2020csnln}
\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Distribution of the per-token routing confidence $x^{\mathrm  {s}}=\max _m S_{n,m}$ (Eq.~\eqref  {eq:belong}) at $\times 4$, accumulated over \emph  {all} test images of (a)~Urban100 and (b)~Manga109 with the final model. Curves are shown for three representative TAB blocks with increasing prototype count $M$; dotted vertical lines mark the uniform-assignment floor $1/M$. In every block the distribution sits clearly to the right of its floor (block-mean $\approx 1.5$--$1.9\times \,1/M$) yet stays far from $1$, confirming that the softmax assignment is \emph  {informative but soft}: tokens commit to a prototype more than chance while retaining the graded confidence that the C3 components (ordering key, IASA gate, soft fallback) rely on. As $M$ grows the mode shifts toward the (lower) floor, consistent with confidence being spread over more slots.}}{17}{figure.caption.12}\protected@file@percent }
\newlabel{fig:xscore_hist}{{5}{17}{Distribution of the per-token routing confidence $x^{\mathrm {s}}=\max _m S_{n,m}$ (Eq.~\eqref {eq:belong}) at $\times 4$, accumulated over \emph {all} test images of (a)~Urban100 and (b)~Manga109 with the final model. Curves are shown for three representative TAB blocks with increasing prototype count $M$; dotted vertical lines mark the uniform-assignment floor $1/M$. In every block the distribution sits clearly to the right of its floor (block-mean $\approx 1.5$--$1.9\times \,1/M$) yet stays far from $1$, confirming that the softmax assignment is \emph {informative but soft}: tokens commit to a prototype more than chance while retaining the graded confidence that the C3 components (ordering key, IASA gate, soft fallback) rely on. As $M$ grows the mode shifts toward the (lower) floor, consistent with confidence being spread over more slots}{figure.caption.12}{}}
\newlabel{fig:xscore_hist@cref}{{[figure][5][]5}{[1][16][]17}{}{}{}}
