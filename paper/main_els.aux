\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Ablation C1 ($\times 4$): dynamic per-image prototypes (DPR, $=$ full model) vs.\ a cross-batch history center with EMA update (EMA-center), both trained for $250$k on DIV2K over three seeds. Values are mean$\pm $std PSNR(dB)/SSIM (Y channel) on Set5 and Urban100. Under a matched protocol that differs \emph  {only} in the prototype generator, dynamic prototypes give the better reconstruction on both benchmarks with lower seed variance.}}{22}{table.4}\protected@file@percent }
\newlabel{tab:abl_c1}{{4}{22}{Ablation C1 ($\times 4$): dynamic per-image prototypes (DPR, $=$ full model) vs.\ a cross-batch history center with EMA update (EMA-center), both trained for $250$k on DIV2K over three seeds. Values are mean$\pm $std PSNR(dB)/SSIM (Y channel) on Set5 and Urban100. Under a matched protocol that differs \emph {only} in the prototype generator, dynamic prototypes give the better reconstruction on both benchmarks with lower seed variance}{table.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Ablation A1 ($\times 4$): prototype query refine. PSNR(dB) mean$\pm $std (Y channel) over three seeds. Enabling refine improves reconstruction on both benchmarks by more than the seed variance, confirming that decoupling prototype generation from confirmation (C2) is quality-positive; we retain it by default.}}{22}{table.5}\protected@file@percent }
\newlabel{tab:abl_a1}{{5}{22}{Ablation A1 ($\times 4$): prototype query refine. PSNR(dB) mean$\pm $std (Y channel) over three seeds. Enabling refine improves reconstruction on both benchmarks by more than the seed variance, confirming that decoupling prototype generation from confirmation (C2) is quality-positive; we retain it by default}{table.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Ablation A2 ($\times 4$): incremental confidence-aware routing components. PSNR(dB) mean$\pm $std (Y channel) over three seeds. The full configuration (v4) is clearly the best on both benchmarks, but the intermediate steps are not monotone; the components are mutually compatible and best as a complete confidence-aware path rather than individually accuracy-additive.}}{23}{table.6}\protected@file@percent }
\newlabel{tab:abl_a2}{{6}{23}{Ablation A2 ($\times 4$): incremental confidence-aware routing components. PSNR(dB) mean$\pm $std (Y channel) over three seeds. The full configuration (v4) is clearly the best on both benchmarks, but the intermediate steps are not monotone; the components are mutually compatible and best as a complete confidence-aware path rather than individually accuracy-additive}{table.6}{}}
\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces Ablation A3 ($\times 4$): prototype balance loss. Reconstruction PSNR(dB) and block-averaged normalized prototype-usage entropy on Urban100 (higher $=$ more balanced), each reported as mean$\pm $std over three seeds. The balance loss raises usage entropy while also \emph  {reducing seed-to-seed variance} on both benchmarks and on the usage entropy itself, supporting the stabilizing role claimed for C4.}}{23}{table.7}\protected@file@percent }
\newlabel{tab:abl_a3}{{7}{23}{Ablation A3 ($\times 4$): prototype balance loss. Reconstruction PSNR(dB) and block-averaged normalized prototype-usage entropy on Urban100 (higher $=$ more balanced), each reported as mean$\pm $std over three seeds. The balance loss raises usage entropy while also \emph {reducing seed-to-seed variance} on both benchmarks and on the usage entropy itself, supporting the stabilizing role claimed for C4}{table.7}{}}
\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces Per-block normalized prototype-usage entropy (Urban100, representative seed $3407$). The balance loss increases usage entropy in every TAB block ($b_0$--$b_7$).}}{24}{table.8}\protected@file@percent }
\newlabel{tab:abl_a3_perblock}{{8}{24}{Per-block normalized prototype-usage entropy (Urban100, representative seed $3407$). The balance loss increases usage entropy in every TAB block ($b_0$--$b_7$)}{table.8}{}}
